# Скопируйте в .env и заполните. .env в git не попадает.
ADDR=:8090
DATABASE_URL=postgres://racketka:racketka@localhost:5433/racketka?sslmode=disable

# Токен бота из BotFather. Обязателен, когда DEV_MODE=false.
BOT_TOKEN=

# Секрет для подписи сессионных JWT. В деве генерируется на лету.
JWT_SECRET=

# true — пускать без Telegram, подставляя тестового пользователя.
DEV_MODE=true

# Экономика
START_BALANCE=1000
HOUSE_EDGE=0.04
MAX_CRASH=1000
MIN_BET=10
MAX_BET=100000
